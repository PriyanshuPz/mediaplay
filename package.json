{
  "name": "panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "NODE_ENV=production bun src/server.ts",
    "build:fe": "bun run build.ts --minify --sourcemap=linked --target browser --outdir=fe/dist",
    "dev:fe": "bun run --watch build.ts --minify --sourcemap=linked --target browser --outdir=fe/dist"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "hono": "^4.11.3",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  }
}
